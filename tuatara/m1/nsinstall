#
# Minimal stand-in for Mozilla's nsinstall, which NSS's and NSPR's make
# builds call on Windows (MozillaBuild normally provides it):
#
#   nsinstall -D DIR...                 create directories
#   nsinstall [opts] FILE... DIR        copy files (or directories) into DIR
#
# -C DIR changes directory first; -m, -o, -g, -t, -l, -L and -R are accepted
# and ignored (permissions, ownership and links don't matter here).

mkdirs=0
while getopts "C:L:m:o:g:DdltR" opt; do
    case $opt in
        D) mkdirs=1 ;;
        C) cd "$OPTARG" || exit 1 ;;
        *) ;;
    esac
done
shift $((OPTIND - 1))

if [ "$mkdirs" = 1 ]; then
    for d in "$@"; do mkdir -p "$d" || exit 1; done
    exit 0
fi
[ $# -ge 2 ] || { echo "nsinstall: need files and a directory" >&2; exit 1; }
dest=${!#}
mkdir -p "$dest" || exit 1
for ((i = 1; i < $#; i++)); do
    cp -rpf "${!i}" "$dest"/ || exit 1
done
